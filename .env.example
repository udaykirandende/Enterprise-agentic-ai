# Optional MCP servers. Use the transport/config format documented by
# langchain-mcp-adapters. Example for a Streamable HTTP server:
# MCP_SERVERS_JSON={"example":{"transport":"streamable_http","url":"https://your-mcp-server.example/mcp"}}
# Only explicitly approved tool names may execute; comma-separated exact names.
MCP_SERVERS_JSON=
MCP_ALLOWED_TOOLS=
